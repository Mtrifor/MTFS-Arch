<!--
  This is a very simple config file with many options missing. For a complete
  set of options with comments, see docs/rc.xml.all
-->

<labwc_config>

  <theme>
    <name>Clearlooks-3.4</name>
    <cornerRadius>8</cornerRadius>
    <font name="sans" size="10" />
  </theme>
<keyboard>
    <default />
    <!-- Use a different terminal emulator -->
    <keybind key="W-S-xRight">
      <action name="NextWindow" />
    </keybind> 
    <!-- Alt + Shift + Tab para volver a la Anterior ventana -->
    <keybind key="W-S-Left">
      <action name="PreviousWindow" />
    </keybind>
    <keybind key="W-Return">
      <action name="Execute" command="ghostty" />
    </keybind>
    <keybind key="W-Delete">
      <action name="Close" />
    </keybind>
    <keybind key="W-END">
      <action name="Execute" command="nwg-drawer" />
    </keybind>
    <!--Escritorios-->
    <keybind key="W-1">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3" />
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4" />
    </keybind>
    <keybind key="W-S-1">
      <action name="SendToDesktop" follow="no" to="1" />
    </keybind>

    <keybind key="W-S-2">
      <action name="SendToDesktop" follow="no" to="2" />
    </keybind>

    <keybind key="W-S-3">
      <action name="SendToDesktop" follow="no" to="3" />
    </keybind>
    <keybind key="W-S-4">
      <action name="SendToDesktop" follow="no" to="4" />
    </keybind>
    <keybind key="W-A-S-1">
      <action name="SendToDesktop" follow="yes" to="1" />
    </keybind>

    <keybind key="W-A-S-2">
      <action name="SendToDesktop" follow="yes" to="2" />
    </keybind>

    <keybind key="W-A-S-3">
      <action name="SendToDesktop" follow="yes" to="3" />
    </keybind>
    <keybind key="W-A-S-4">
      <action name="SendToDesktop" follow="yes" to="4" />
    </keybind>
    <!--
      Remove a previously defined keybind
      A shorter alternative is <keybind key="W-F4" />
    -->
    <keybind key="W-F4">
      <action name="None" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
    <!-- Show a custom menu on desktop right click -->
    <context name="Root">
      <mousebind button="Left" action="Press">
        <action name="None"/>
      </mousebind>
      <mousebind direction="Up" action="Scroll">
        <action name="None" />
      </mousebind>
      <mousebind direction="Down" action="Scroll">
        <action name="None" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="some-custom-menu" />
      </mousebind>
    </context>
  </mouse>

  <desktops number="4">
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
</desktops>

  
</labwc_config>
