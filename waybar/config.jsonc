{
    "layer": "bottom",
    "position": "bottom",
    "height": 44,
    "width": 980,
    "spacing": 4,
    "modules-left": [
        "custom/menu"
    ],
    "modules-center": [
        "wlr/taskbar"
    ],
    "modules-right": [
        "tray",
        "wireplumber",
        "bluetooth",
        "clock",
        "custom/system"
    ],
    "tray": {
    "spacing": 10
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "icon-theme": "Adwaita",
        "tooltip-format": "{title}",
        "on-click": "minimize-raise",
        "on-middle-click": "minimize",
        "sort-by": "id",
        "all-outputs": false
    },
    "wireplumber": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": ["", "", ""],
        "tooltip": true,
        "tooltip-format": "{volume}%",
        "on-click": "pavucontrol"
    },
    "bluetooth": {
        "format": "",
        "format-connected": "",
        "tooltip-format": "{device_alias}",
        "on-click": "blueman-manager"
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/menu": {
        "format": "",
        "on-click": "nwg-drawer",
        "tooltip": false
    },
    "custom/system": {
        "format": "{}",
        "return-type": "json",
        "exec": "echo '{\"text\":\"\",\"tooltip\":\"WiFi: '$(nmcli -t -f active,ssid,signal dev wifi 2>/dev/null | grep ^yes | awk -F: '{printf \"%s %s%%\",$2,$3}' || echo \"n/a\")'\\nRAM: '$(free -m | awk '/^Mem:/ {printf \"%.1fG/%.1fG (%.f%%)\",$3/1024,$2/1024,$3*100/$2}')'\\nCPU: '$(grep '^cpu ' /proc/stat | awk '{usage=($2+$4)*100/($2+$4+$5); printf \"%.f%%\",usage}')'\"}'",
        "interval": 10,
        "tooltip": false
    }
}
